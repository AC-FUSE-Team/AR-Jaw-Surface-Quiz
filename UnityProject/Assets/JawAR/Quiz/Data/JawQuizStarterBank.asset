  bankId: jaw-surface-starter-v1
  questions:
  - questionId: jaw.region.lower-incisors.v1
    expectedRegionId: LowerIncisors
    displayPrompt: Identify the Lower Incisors.
    spokenPrompt: Identify the Lower Incisors.
    correctFeedback: "Correct \u2014 you identified the Lower Incisors."
    incorrectFeedback: Not quite. Compare the selected colour with the landmark location.
    firstHint: Look along the tooth-bearing upper border.
    secondHint: The lower incisors occupy the anterior midline of the mandibular
      dental arch.
    educationalExplanation: The lower incisors occupy the anterior midline of the
      mandibular dental arch.
    difficulty: 0
    enabled: 1
  - questionId: jaw.region.left-ramus.v1
    expectedRegionId: LeftRamus
    displayPrompt: Identify the Left Ramus.
    spokenPrompt: Identify the Left Ramus.
    correctFeedback: "Correct \u2014 you identified the Left Ramus."
    incorrectFeedback: Not quite. Compare the selected colour with the landmark location.
    firstHint: Look on the anatomical left side of the mandible.
    secondHint: The ramus is the broad ascending posterior part of the mandible.
    educationalExplanation: The ramus is the broad ascending posterior part of the
      mandible.
    difficulty: 0
    enabled: 1
  - questionId: jaw.region.right-ramus.v1
    expectedRegionId: RightRamus
    displayPrompt: Identify the Right Ramus.
